{
    "name": "hier-sync-local",
    "productName": "Hier Sync Local",
    "version": "1.1.0",
    "description": "Desktop app for ZKTeco attendance devices (Laravel + Electron)",
    "author": "Hier Business Solutions Inc.",
    "main": "electron/main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "stage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage.ps1",
        "dist": "npm run stage && electron-builder --win --x64",
        "release:patch": "npm version patch -m \"Release v%s\"",
        "release:minor": "npm version minor -m \"Release v%s\"",
        "release:major": "npm version major -m \"Release v%s\"",
        "version": "node scripts/changelog-release.js && git add CHANGELOG.md"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "rcedit": "^4.0.1"
    },
    "build": {
        "appId": "com.hierpayroll.hiersynclocal",
        "productName": "Hier Sync Local",
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/**",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "build-stage/php",
                "to": "php"
            },
            {
                "from": "build-stage/laravel",
                "to": "laravel"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico",
            "signAndEditExecutable": false,
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "include": "build/installer.nsh",
            "artifactName": "Hier-Sync-Local-Setup-${version}.exe"
        },
        "afterPack": "build/after-pack.js"
    }
}
